# Neon: MagicTracker (project damp-heart-11994227, branch main)
# Pooled - used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/magictracker?sslmode=verify-full"

# Direct/unpooled - used by drizzle-kit migrations and the bulk ingest COPY.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/magictracker?sslmode=verify-full"

# Auth.js
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth - fill these in (see README "Google sign-in setup")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only these emails may sign in. Comma-separated.
ALLOWED_EMAILS="you@example.com"
